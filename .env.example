# Flask
SECRET_KEY=replace-with-a-long-random-secret

# Manager LLM (required when the application factory is added in a later phase)
AGENT_MANAGER_PROVIDER=openai
AGENT_MANAGER_MODEL=replace-with-your-manager-model

# Provider credentials: set only the provider selected above.
OPENAI_API_KEY=replace-with-your-openai-api-key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional OpenAI Chat Completions-compatible endpoint.
# Its configured name becomes the AGENT_<ROLE>_PROVIDER value.
# Example: AGENT_MANAGER_PROVIDER=local_model
OAICOMPAT_LOCAL_MODEL_BASE_URL=https://your-compatible-endpoint.example/v1/chat/completions
OAICOMPAT_LOCAL_MODEL_API_KEY=replace-if-your-endpoint-requires-a-key
